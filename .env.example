TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_MODEL=gpt-4o-mini
# polling for local use; webhook for an HTTPS host; disabled for health-only startup
BOT_MODE=polling
APP_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
# Blank infers the current academic year. Override when importing a different year.
NUSMODS_ACADEMIC_YEAR=
# 0 asks for an end time. Any positive value is visibly labelled as assumed.
DEFAULT_EVENT_DURATION_MINUTES=0
# Optional extraction debugging is off by default; pending text expires after 24 hours.
RETAIN_EXTRACTIONS=false
EXTRACTION_RETENTION_DAYS=7
PENDING_TTL_HOURS=24
# Other Going plans on one day before cards warn "Busy day". 0 disables the warning.
BUSY_DAY_THRESHOLD=3
# Night-before summary: Singapore hour (0-23) from which it may be sent.
NIGHTLY_HOUR=20
# Lets an external scheduler (e.g. Render Cron every 10 minutes) trigger reminders with
#   curl -X POST -H "X-Jobs-Secret: $JOBS_SECRET" $APP_BASE_URL/internal/jobs/run
# Blank disables the endpoint; the in-process tick still runs while the server is awake.
JOBS_SECRET=
# Mini App. MINI_APP_URL is the HTTPS address Telegram opens; when the built frontend is
# served by this backend it is APP_BASE_URL + /app/ . Blank leaves the menu button unset.
MINI_APP_URL=
# Only for a separately hosted development frontend: its exact origin, enabling CORS for it.
MINI_APP_DEV_ORIGIN=
# Optional dedicated session signing secret (32+ characters). Blank derives one from the bot token.
SESSION_SECRET=
# Encrypts stored personal calendar links. Blank derives one from the bot token.
CALENDAR_LINK_KEY=
LOG_LEVEL=INFO
