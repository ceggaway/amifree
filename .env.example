TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_MODEL=gpt-4o-mini
# polling for local use; webhook for an HTTPS host; disabled for health-only startup
BOT_MODE=polling
APP_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
# Blank infers the current academic year. Override when importing a different year.
NUSMODS_ACADEMIC_YEAR=
# Assumed length when a message has a start but no end time ('dinner 7pm today'); the card
# labels it as assumed. 0 asks for an end time instead.
DEFAULT_EVENT_DURATION_MINUTES=120
# Read the text in forwarded pictures with the OpenAI model (sends the image to OpenAI).
READ_PICTURES=true
# Blank uses OPENAI_MODEL, which must accept images.
OPENAI_VISION_MODEL=
# Optional extraction debugging is off by default; pending text expires after 24 hours.
RETAIN_EXTRACTIONS=false
EXTRACTION_RETENTION_DAYS=7
PENDING_TTL_HOURS=24
# Other Going plans on one day before cards warn "Busy day". 0 disables the warning.
BUSY_DAY_THRESHOLD=3
# Night-before summary: Singapore hour (0-23) from which it may be sent.
NIGHTLY_HOUR=20
# Lets an external scheduler (e.g. Render Cron every 10 minutes) trigger reminders with
#   curl -X POST -H "X-Jobs-Secret: $JOBS_SECRET" $APP_BASE_URL/internal/jobs/run
# Blank disables the endpoint; the in-process tick still runs while the server is awake.
JOBS_SECRET=
# "Share your Google Calendar with AmIFree": the key file of a Google service account (the whole
# JSON, or that JSON in base64). Students share their calendar with its email and the bot adds
# the plans they say Going to. Blank hides the feature. See README, "Share a Google calendar".
GOOGLE_SERVICE_ACCOUNT=
# Mini App. MINI_APP_URL is the HTTPS address Telegram opens; when the built frontend is
# served by this backend it is APP_BASE_URL + /app/ . Blank leaves the menu button unset.
MINI_APP_URL=
# Only for a separately hosted development frontend: its exact origin, enabling CORS for it.
MINI_APP_DEV_ORIGIN=
# Optional dedicated session signing secret (32+ characters). Blank derives one from the bot token.
SESSION_SECRET=
# Encrypts stored personal calendar links. Blank derives one from the bot token.
CALENDAR_LINK_KEY=
# Group features.
# Lets poll cards open the Mini App heatmap straight from a group. Create the short name with
# /newapp in BotFather; both blank hides the button.
BOT_USERNAME=
MINI_APP_SHORT_NAME=
# Comma-separated group chat ids with Clubs Pro (CSV export, per-event stats). group_plans rows
# work too; this is for pilots before payments exist.
PRO_CHAT_IDS=
# Clubs Pro. Export and the per-event breakdown are free unless this is true.
EXPORT_REQUIRES_PRO=false
PRO_PRICE_STARS=250
PRO_DAYS=30
# /refund returns a buyer's Stars within this many days of paying.
REFUND_WINDOW_DAYS=3
# Telegram id that gets a private message when background jobs keep failing (0 = off).
ALERT_TELEGRAM_ID=0
ALERT_COOLDOWN_MINUTES=60
# A group card is edited at most this often, in seconds; bursts of RSVPs are combined.
CARD_EDIT_INTERVAL_SECONDS=3
# Event detection: language-model reads allowed per group per hour (when an admin turns it on).
DETECTION_PER_HOUR=20
# PostHog analytics (project API key, phc_...). Blank = off. EU projects use https://eu.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
LOG_LEVEL=INFO
